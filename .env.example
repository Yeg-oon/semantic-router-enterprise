# --- MODE SELECTION ---
# Option A: Cloud (OpenAI) - Leave LOCAL_LLM_URL empty or comment it out
# Option B: Local (Ollama) - Set LOCAL_LLM_URL
LOCAL_LLM_URL=http://host.docker.internal:11434/v1

# --- API KEYS ---
OPENAI_API_KEY=sk-proj-YOUR-CLOUD-KEY-HERE

# --- MODEL CONFIGURATION (The "Adapted" Part) ---
# You can change these model names anytime without rewriting code!
CLASSIFIER_MODEL=gpt-4o-mini
FAST_MODEL=gpt-3.5-turbo
SMART_MODEL=gpt-4o

# --- SYSTEM PROMPTS ---
CLASSIFIER_PROMPT=Classify intent as 'simple_support' or 'complex_task'. Output only the label.

# --- SECURITY & RATE LIMITING ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=["*"]

# --- CIRCUIT BREAKER CONFIGURATION ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
CIRCUIT_BREAKER_EXPECTED_EXCEPTION=Exception

# --- LOGGING & MONITORING ---
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true

# --- PERFORMANCE ---
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=60